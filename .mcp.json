{
  "mcpServers": {
    "speak-app": {
      "command": "/bin/zsh",
      "args": ["-lc", "exec \"$HOME/Library/Application Support/speak/mcp/bin/speak-mcp\""]
    },
    "xcode": {
      "command": "xcrun",
      "args": ["mcpbridge"]
    },
    "apple-docs": {
      "command": "npx",
      "args": ["-y", "@kimsungwhee/apple-docs-mcp"]
    }
  }
}
